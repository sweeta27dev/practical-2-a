# Practical No. 7(B)

## Aim
To demonstrate HTTP data retrieval using Fetch API and understand Axios as an alternative for making HTTP requests.

## Code

### `src/App.js`

```jsx
import React from "react";
import ApiClient from "./components/ApiClient";

function App() {
  return <ApiClient />;
}

export default App;
```

### `src/components/ApiClient.jsx` (Fetch API)

```jsx
import React, { useEffect, useState } from "react";

function ApiClient() {
  const [post, setPost] = useState(null);

  useEffect(() => {
    fetch("https://jsonplaceholder.typicode.com/posts/1")
      .then((response) => response.json())
      .then((data) => setPost(data))
      .catch((error) => console.error("API Error:", error));
  }, []);

  return (
    <div>
      <h2>API Response</h2>
      {post && (
        <div>
          <p>ID: {post.id}</p>
          <p>Title: {post.title}</p>
        </div>
      )}
    </div>
  );
}

export default ApiClient;
```

### Optional Axios Version

Install Axios before running:

```bash
npm install axios
```

```jsx
import React, { useEffect, useState } from "react";
import axios from "axios";

function ApiClient() {
  const [post, setPost] = useState(null);

  useEffect(() => {
    axios
      .get("https://jsonplaceholder.typicode.com/posts/1")
      .then((response) => {
        setPost(response.data);
        console.log(response.data);
      })
      .catch((error) => {
        console.error("API Error:", error);
      });
  }, []);

  return (
    <div>
      <h2>API Response</h2>
      {post ? (
        <div>
          <p>ID: {post.id}</p>
          <p>Title: {post.title}</p>
        </div>
      ) : (
        <p>Loading...</p>
      )}
    </div>
  );
}

export default ApiClient;
```

