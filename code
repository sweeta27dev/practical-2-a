Practical No. 2(A): Creating Reusable React Functional Components

Aim

To create reusable React functional components and render them from App.js.

Source Code

1. src/App.js

import React from "react";
import Header from "./components/Header";
import Footer from "./components/Footer";

function App() {
  return (
    <div>
      <Header />
      <Footer />
    </div>
  );
}

export default App;

2. src/components/Header.jsx

import React from "react";

function Header() {
  return <h1>College Website</h1>;
}

export default Header;

3. src/components/Footer.jsx

import React from "react";

function Footer() {
  return <p>Copyright 2026</p>;
}

export default Footer;

Output

College Website
Copyright 2026

Result

Successfully created reusable React functional components (Header and Footer) and rendered them in App.js.
